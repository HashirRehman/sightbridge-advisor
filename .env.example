# Copy to backend/.env for local development. Never commit real values.

# --- Backend (FastAPI) ---
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://sightbridge:sightbridge@localhost:5433/sightbridge
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS credentials come from your AWS profile (AWS_PROFILE), never from this file.
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# bedrock (default) or local (deterministic lexical embedder; dev/tests only, refused in production)
EMBEDDING_PROVIDER=local
# bedrock (default) or local (extractive stand-in; dev only, refused in production)
LLM_PROVIDER=local
# Similarity floor depends on the embedding model: 0.20 for the local embedder; Titan is calibrated separately.
RETRIEVAL_MIN_SIMILARITY=0.20
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# cognito (default) or local (HS256 tokens minted by the Next.js dev server; refused in production)
AUTH_PROVIDER=local
# Generate with: openssl rand -hex 32  (must match the frontend's LOCAL_AUTH_SECRET)
LOCAL_AUTH_SECRET=
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
ADMIN_GROUP_NAME=admin

DOCUMENTS_BUCKET=

# --- Frontend (Next.js) — copy to frontend/.env.local ---
# API_BASE_URL=http://localhost:8080
# COGNITO_REGION=us-east-1
# COGNITO_APP_CLIENT_ID=
# APP_ENV=local
# AUTH_PROVIDER=local
# LOCAL_AUTH_SECRET=   (same value as the backend)
# LOCAL_DEMO_USERS=[{"email":"advisor@demo.local","password":"choose-one","role":"advisor"},{"email":"admin@demo.local","password":"choose-another","role":"admin"}]
