alarm_email        = "you@example.com"
monthly_budget_usd = 10

# After pushing the repository:
# enable_amplify        = true
# github_repository_url = "https://github.com/<owner>/sightbridge-advisor"
# github_access_token   = "<set via TF_VAR_github_access_token, never in this file>"

region = "ap-southeast-2"
retrieval_min_similarity = 0.40
bedrock_api_key_ssm_parameter = "/sightbridge-advisor/production/bedrock-api-key"

# Optional API deployments after CI succeeds on main (frontend uses Amplify).
# enable_github_deployments = true
# github_deployment_subjects = ["repo:OWNER/REPOSITORY:ref:refs/heads/main"]
# New repositories may use repo:OWNER@OWNER_ID/REPOSITORY@REPO_ID:ref:refs/heads/main.
